# Copy to .env in this folder (src/frontend/mobile).
# Restart `npx expo start` after changes.

# Backend API
# - Web + iOS Simulator + Android Emulator on same machine: localhost is fine
# - Physical phone on Wi‑Fi: use your PC's LAN IP (ipconfig / ifconfig)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5069

# Public app URL for organization invite links (Expo web default port)
EXPO_PUBLIC_APP_BASE_URL=http://localhost:8081

# Campus map (web): Leaflet + OpenStreetMap via CDN (unpkg) — no map API key required.
# Ensure buildings have latitude/longitude in org admin (floorplan workspace / maps API).

# Example for a physical device on the same network:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.72.240:5069
#
# Backend (Omada.Api) — set the same LAN URL so image URLs in API responses work on phones:
# AppConfig__BaseUrl=http://192.168.72.240:5069
