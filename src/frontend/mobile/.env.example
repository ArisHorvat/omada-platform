# Copy to .env in this folder (src/frontend/mobile).
# Restart `npx expo start` after changes.

# Backend API (use your machine LAN IP when testing on a physical phone)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5069

# Public app URL for organization invite links (Expo web default port)
EXPO_PUBLIC_APP_BASE_URL=http://localhost:8081

# Example for device on same Wi‑Fi:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5069
