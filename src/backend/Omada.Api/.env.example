# Copy to .env in this folder (src/backend/Omada.Api). Secrets only — model IDs and URLs
# live in appsettings.json / appsettings.Development.json unless you need to override them here.

# --- Required for local dev (pick one approach per setting) ---

# SQL Server (overrides appsettings when set)
# ConnectionStrings__DefaultConnection=Server=YOUR_HOST;Database=Omada;Trusted_Connection=True;TrustServerCertificate=True

# JWT signing (required if Jwt:Key is empty in appsettings)
# Jwt__Key=your-local-dev-signing-key-at-least-32-characters

# Roboflow floorplan AI (secret)
ROBOFLOW_API_KEY=

# Optional overrides (normally set in appsettings.json)
# ROBOFLOW_MODEL_ID=room-segmentation-o7iga/4
# ROBOFLOW_ELEMENTS_MODEL_ID=cubicasa5k-2-qpmsa/6
# ROBOFLOW_ELEMENTS_MODEL_ENABLED=true

# Public API URL (LAN IP for physical devices, etc.)
# AppConfig__BaseUrl=http://192.168.1.10:5069

# Public app URL for organization invite links (Expo web)
# AppConfig__PublicAppUrl=http://192.168.1.10:8081

# Brevo transactional email (optional — without these, emails are logged to console only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Omada

# Web spider AI fallback (secret; either name works)
# Gemini__ApiKey=
# GEMINI_API_KEY=
